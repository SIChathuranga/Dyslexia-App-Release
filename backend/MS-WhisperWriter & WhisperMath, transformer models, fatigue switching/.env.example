# Flask Configuration
FLASK_ENV=development
FLASK_DEBUG=1

# Server Configuration
HOST=0.0.0.0
PORT=5000

# Security — REQUIRED in production (Render sets this via render.yaml)
# Generate a random key: python -c "import secrets; print(secrets.token_hex(32))"
# SECRET_KEY=your-random-secret-key-here

# Model Configuration
MODEL_PATH=models/letter_model.tflite

# CORS - Add your React Native development machine IP
# For Render production, set to your frontend domain(s):
# CORS_ORIGINS=https://your-app.example.com,exp://your-expo-url
CORS_ORIGINS=*

# Keepalive / Heartbeat (Render)
# Set KEEPALIVE_ENABLED=true in Render to let this app periodically ping itself.
# Usually KEEPALIVE_TARGET_URL can be your Render public URL, e.g.:
# KEEPALIVE_TARGET_URL=https://your-service-name.onrender.com
KEEPALIVE_ENABLED=false
KEEPALIVE_INTERVAL_SECONDS=600
KEEPALIVE_ENDPOINT_PATH=/heartbeat
KEEPALIVE_TARGET_URL=

# MongoDB Atlas Configuration
# Get your connection string from: https://cloud.mongodb.com
# Format: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<dbname>
MONGODB_URI=mongodb+srv://sichathuranga2001_db_user:sani1234@cluster0.tq9cwoq.mongodb.net/?appName=Cluster0
MONGODB_DB_NAME=dyslearn
