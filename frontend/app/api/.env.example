# ==============================================================================
# Backend API URLs
# ==============================================================================
# Copy this file to .env and update the URLs for your environment.
#
# LOCAL DEVELOPMENT:
#   Use http://localhost:<port> (auto-detected if left commented out)
#
# RENDER DEPLOYMENT:
#   Use your Render service URLs, e.g.:
#   EXPO_PUBLIC_PHOTO_SPELLING_API_URL=https://your-photo-spelling-api.onrender.com
#   EXPO_PUBLIC_WRITING_MATH_API_URL=https://your-writing-math-api.onrender.com
#   EXPO_PUBLIC_MULTI_SKILL_API_URL=https://your-multi-skill-api.onrender.com
# ==============================================================================

# Photo-Based Spelling Challenge Backend (FastAPI, default port 8000)
EXPO_PUBLIC_PHOTO_SPELLING_API_URL=http://localhost:9000

# Writing & Math Real-Time Feedback Backend (Flask, default port 5000)
EXPO_PUBLIC_WRITING_MATH_API_URL=http://localhost:5000

# Multi-Skill Learning Game Backend (Flask, default port 5001)
EXPO_PUBLIC_MULTI_SKILL_API_URL=http://localhost:5001

# Actions / Cognitive Assessment Backend (Action detection API, default port 8000)
EXPO_PUBLIC_ACTION_DETECTION_API_URL=http://localhost:8000
