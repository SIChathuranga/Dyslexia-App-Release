{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noEmit": true,
    "moduleResolution": "bundler",
    "forceConsistentCasingInFileNames": true,
    "jsx": "react-jsx",
    "allowJs": true
  },
  "include": [
    "App.js",
    "src/**/*.ts",
    "src/**/*.tsx",
    "modules/**/*.js",
    "screens/**/*.js",
    "services/**/*.js"
  ],
  "exclude": [
    "node_modules"
  ]
}
